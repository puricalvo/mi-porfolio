---
// src/components/ProjectCard.astro
import CredentialModal from "./CredentialModal.astro";

interface DemoCredential {
	title: string;
	username: string;
	password: string;
}

interface Props {
	title: string;
	description: string;
	tags: string[];
	demoUrl: string;
	codeUrl: string;
	apiUrl?: string;
	credentials?: DemoCredential[];
}

const { title, description, tags, demoUrl, codeUrl, apiUrl, credentials } = Astro.props;
---

<div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden hover:border-blue-500 transition-all group">
	<div class="p-8">
		<div class="flex flex-wrap gap-2 mb-4">
			{tags.map((tag) => (
				<span class="bg-slate-900 text-blue-300 px-3 py-1 rounded-full text-xs font-semibold border border-blue-900/30">
					{tag}
				</span>
			))}
		</div>
		<h3 class="text-2xl font-bold mb-4 group-hover:text-blue-400 transition-colors">{title}</h3>
		<p class="text-slate-400 mb-6 leading-relaxed">
			{description}
		</p>
		<div class="flex gap-4">
			<a href={demoUrl} target="_blank" class="text-blue-400 font-bold hover:underline">Ver Demo →</a>
			<a href={codeUrl} target="_blank" class="text-slate-300 hover:text-white">Código Fuente</a>
			{apiUrl && <a href={apiUrl} target="_blank" class="text-slate-300 hover:text-white">Código API</a>}
		</div>
		{credentials?.length && (
			<div class="mt-5 pt-5 border-t border-slate-700">
				<p class="text-sm text-slate-500 mb-2">Acceso a la demo:</p>
				<div class="flex flex-wrap gap-4">
					{credentials.map((credential, index) => (
						<CredentialModal
							id={`project-credentials-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${index}`}
							title={credential.title}
							username={credential.username}
							password={credential.password}
						/>
					))}
				</div>
			</div>
		)}
	</div>
</div>