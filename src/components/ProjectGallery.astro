---
interface Image {
    src: string;
    title: string;
}

interface Props {
    images: Image[];
}

const { images } = Astro.props as Props;

const galleryId = `gallery-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="relative" data-gallery={galleryId}>

    <div class="overflow-hidden rounded-2xl border border-slate-700 mb-6 sm:mb-8">

        <img
            data-gallery-image
            src={images[0].src}
            alt={images[0].title}
            class="w-full h-auto transition-opacity duration-500"
        />

    </div>


    <p
        data-gallery-title
        class="mt-5 text-center text-slate-400 text-sm"
    >
        {images[0].title}
    </p>


    <div class="flex items-center justify-center gap-6 mt-4">

        <button
            type="button"
            data-gallery-prev
            class="text-blue-400 hover:text-white transition duration-200 hover:scale-110 cursor-pointer"
            aria-label="Imagen anterior"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 19.5 8.25 12l7.5-7.5"
                />
            </svg>
        </button>


        <div
            data-gallery-dots
            class="flex gap-2"
        >

            {
                images.map((_, index) => (
                    <button
                        type="button"
                        data-gallery-dot={index}
                        aria-label={`Ver imagen ${index + 1}`}
                        class:list={[
                            "w-2 h-2 rounded-full transition cursor-pointer",
                            index === 0
                                ? "bg-blue-500"
                                : "bg-slate-600",
                        ]}
                    ></button>
                ))
            }

        </div>


        <button
            type="button"
            data-gallery-next
            class="text-blue-400 hover:text-white transition duration-200 hover:scale-110 cursor-pointer"
            aria-label="Imagen siguiente"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.25 4.5 15.75 12l-7.5 7.5"
                />
            </svg>
        </button>

    </div>

</div>


<script is:inline define:vars={{ images, galleryId }}>

    const gallery = document.querySelector(
        `[data-gallery="${galleryId}"]`
    );

    if (gallery) {

        const image = gallery.querySelector(
            "[data-gallery-image]"
        );

        const title = gallery.querySelector(
            "[data-gallery-title]"
        );

        const prev = gallery.querySelector(
            "[data-gallery-prev]"
        );

        const next = gallery.querySelector(
            "[data-gallery-next]"
        );

        const dots = gallery.querySelectorAll(
            "[data-gallery-dot]"
        );


        if (
            image instanceof HTMLImageElement &&
            title instanceof HTMLElement &&
            prev instanceof HTMLButtonElement &&
            next instanceof HTMLButtonElement
        ) {

            let current = 0;


            function updateGallery() {

                image.classList.add("opacity-0");


                setTimeout(() => {

                    image.src = images[current].src;
                    image.alt = images[current].title;

                    title.textContent =
                        images[current].title;


                    dots.forEach((dot, index) => {

                        if (index === current) {

                            dot.classList.remove(
                                "bg-slate-600"
                            );

                            dot.classList.add(
                                "bg-blue-500"
                            );

                        } else {

                            dot.classList.remove(
                                "bg-blue-500"
                            );

                            dot.classList.add(
                                "bg-slate-600"
                            );

                        }

                    });


                    image.classList.remove("opacity-0");

                }, 250);

            }


            prev.addEventListener("click", () => {

                current--;

                if (current < 0) {
                    current = images.length - 1;
                }

                updateGallery();

            });


            next.addEventListener("click", () => {

                current++;

                if (current >= images.length) {
                    current = 0;
                }

                updateGallery();

            });


            dots.forEach((dot) => {

                dot.addEventListener("click", () => {

                    const index = Number(
                        dot.getAttribute(
                            "data-gallery-dot"
                        )
                    );

                    current = index;

                    updateGallery();

                });

            });

        }

    }

</script>