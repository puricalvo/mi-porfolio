---
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import CredentialModal from "./CredentialModal.astro";
import ProjectGallery from "./ProjectGallery.astro";

const { projects } = Astro.props;
---

<div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden">

    <div class="p-5 sm:p-8">

        <!-- CABECERA GENERAL -->

        <div class="mb-8">

            <span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-4">
                ☕ Proyecto relacionado
            </span>

            <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
                Cafetería desde 1939
            </h2>

            <p class="text-slate-400 leading-relaxed max-w-4xl">
                Dos aplicaciones independientes que forman parte del mismo proyecto:
                <strong class="text-slate-200">CoffeeShopAstro</strong> es la web pública
                de la cafetería y <strong class="text-slate-200">Fresh Coffee</strong>
                es su aplicación de pedidos.
            </p>

            <p class="text-slate-500 text-sm mt-4">
                Ambos proyectos utilizan el CMS Builder para gestionar el contenido y los datos.
                Para conocer cómo funciona el CMS, puedes consultar el proyecto destacado.
            </p>

        </div>


        <!-- PROYECTOS INTERNOS -->

        <div class="grid grid-cols-1 gap-6">


            <!-- COFFEESHOPASTRO -->

            <article class="bg-slate-900/60 border border-slate-700 rounded-2xl p-5 sm:p-6">

                <div class="mb-5">

                    <span class="text-xs font-semibold text-blue-400 uppercase tracking-wide">
                        Web de la cafetería
                    </span>

                    <h3 class="text-2xl font-bold text-white mt-2 mb-3">
                        {projects[0].title}
                    </h3>

                    <p class="text-slate-400 leading-relaxed">
                        {projects[0].description}
                    </p>

                </div>


                <div class="flex flex-wrap gap-2 mb-6">

                    {projects[0].tags.map((tag: string) => (
                        <Badge text={tag} />
                    ))}

                </div>


                <div class="flex flex-wrap gap-4">

                    <Button
                        href={projects[0].demoUrl}
                        text="🌍 Ver Web"
                        variant="success"
                    />

                    <Button
                        href={projects[0].codeUrl}
                        text="💻 Código"
                        variant="secondary"
                    />

                </div>

            </article>



            <!-- FRESH COFFEE -->

            <article class="bg-slate-900/60 border border-slate-700 rounded-2xl p-5 sm:p-6">

                <div class="mb-5">

                    <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wide">
                        Aplicación de pedidos
                    </span>

                    <h3 class="text-2xl font-bold text-white mt-2 mb-3">
                        {projects[1].title}
                    </h3>

                    <p class="text-slate-400 leading-relaxed">
                        {projects[1].description}
                    </p>

                </div>


                <!-- FUNCIONES -->

                <div class="space-y-2 mb-6">

                    {projects[1].features.map((feature: string) => (
                        <div class="flex items-center gap-2 text-slate-300 text-sm">

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 text-emerald-400 shrink-0"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293z"
                                    clip-rule="evenodd"
                                />
                            </svg>

                            <span>{feature}</span>

                        </div>
                    ))}

                </div>


                <!-- GALERÍA -->

                <div class="mb-6">
                    <ProjectGallery images={projects[1].gallery} />
                </div>


                <!-- TECNOLOGÍAS -->

                <div class="flex flex-wrap gap-2 mb-6">

                    {projects[1].tags.map((tag: string) => (
                        <Badge text={tag} />
                    ))}

                </div>


                <!-- BOTONES -->

                <div class="flex flex-wrap gap-3">

                    <Button
                        href={projects[1].demoUrl}
                        text="🌐 Ver App"
                        variant="primary"
                    />

                    <Button
                        href={projects[1].codeUrl}
                        text="💻 Código"
                        variant="secondary"
                    />

                </div>


                <!-- CREDENCIALES -->

                <div class="mt-5 pt-5 border-t border-slate-700">

                    <p class="text-sm text-slate-500 mb-2">
                        Acceso a la demo:
                    </p>

                    <CredentialModal
                        id="freshcoffee-credentials"
                        title="Fresh Coffee · Credenciales"
                        username={projects[1].credentials.username}
                        password={projects[1].credentials.password}
                    />

                </div>

            </article>

        </div>

    </div>

</div>