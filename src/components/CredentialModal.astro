---
interface Props {
    id: string;
    title: string;
    username: string;
    password: string;
}

const { id, title, username, password } = Astro.props;
---

<button
    type="button"
    class="text-slate-300 hover:text-blue-400 transition-colors underline underline-offset-4 cursor-pointer"
    data-open-credentials={id}
>
    Ver credenciales
</button>

<dialog
    id={id}
    class="credential-modal"
>
    <div class="modal-content">
        <div class="flex items-center justify-between gap-4 mb-6">
            <h3 class="text-xl font-bold text-white">
                {title}
            </h3>

            <button
                type="button"
                class="text-slate-400 hover:text-white text-2xl leading-none cursor-pointer"
                data-close-credentials={id}
                aria-label="Cerrar"
            >
                ×
            </button>
        </div>

        <div class="space-y-4">
            <div>
                <p class="text-sm text-slate-400 mb-1">Usuario</p>
                <div class="bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-200 break-all">
                    {username}
                </div>
            </div>

            <div>
                <p class="text-sm text-slate-400 mb-1">Contraseña</p>
                <div class="bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-200">
                    {password}
                </div>
            </div>
        </div>

        <p class="text-sm text-slate-500 mt-6">
            Credenciales de demostración. No utilizar para cuentas reales.
        </p>
    </div>
</dialog>

<script is:inline>
    document.addEventListener("click", (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const openButton = target.closest("[data-open-credentials]");
        const closeButton = target.closest("[data-close-credentials]");

        if (openButton) {
            const id = openButton.getAttribute("data-open-credentials");
            const modal = id ? document.getElementById(id) : null;

            if (modal instanceof HTMLDialogElement) {
                modal.showModal();
            }
        }

        if (closeButton) {
            const id = closeButton.getAttribute("data-close-credentials");
            const modal = id ? document.getElementById(id) : null;

            if (modal instanceof HTMLDialogElement) {
                modal.close();
            }
        }
    });

    document.addEventListener("click", (event) => {
        const target = event.target;

        if (!(target instanceof HTMLDialogElement)) return;

        if (event.target === target) {
            target.close();
        }
    });
</script>

<style>
    .credential-modal {
        width: min(92vw, 420px);
        margin: auto;
        padding: 0;
        border: 1px solid rgb(51 65 85);
        border-radius: 1rem;
        background: rgb(30 41 59);
        color: white;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
    }

    .credential-modal::backdrop {
        background: rgba(2, 6, 23, 0.75);
        backdrop-filter: blur(4px);
    }

    .modal-content {
        padding: 1.5rem;
    }
</style>